  "components": {
    "schemas": {
      "AlertCreate": {
        "properties": {
          "asset_id": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Asset Id"
          },
          "symbol": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Symbol"
          },
          "alert_type": {
            "type": "string",
            "title": "Alert Type",
            "default": "dip_threshold"
          },
          "threshold": {
            "type": "number",
            "title": "Threshold"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "threshold"
        ],
        "title": "AlertCreate"
      },
      "AlertResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "asset_id": {
            "type": "integer",
            "title": "Asset Id"
          },
          "alert_type": {
            "type": "string",
            "title": "Alert Type"
          },
          "threshold": {
            "type": "number",
            "title": "Threshold"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "asset_id",
          "alert_type",
          "threshold",
          "is_active",
          "created_at"
        ],
        "title": "AlertResponse"
      },
      "AssetResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "asset_type": {
            "type": "string",
            "title": "Asset Type"
          },
          "exchange": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exchange"
          }
        },
        "type": "object",
        "required": [
          "id",
          "symbol",
          "name",
          "asset_type",
          "exchange"
        ],
        "title": "AssetResponse"
      },
      "DipAnalysisRequest": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol",
            "examples": [
              "VOO"
            ]
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "title": "Start Date"
          },
