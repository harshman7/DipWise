{
  "openapi": "3.1.0",
  "info": {
    "title": "DipWise API",
    "version": "0.1.0"
  },
  "paths": {
    "/assets/": {
      "get": {
        "tags": [
          "assets"
        ],
        "summary": "List Assets",
        "description": "List all tracked assets.",
        "operationId": "list_assets_assets__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AssetResponse"
                  },
                  "type": "array",
                  "title": "Response List Assets Assets  Get"
                }
              }
            }
          }
        }
      }
    },
    "/assets/{symbol}": {
      "get": {
        "tags": [
          "assets"
        ],
        "summary": "Get Asset",
        "description": "Get a single asset by symbol.",
        "operationId": "get_asset_assets__symbol__get",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Symbol"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssetResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/prices/{symbol}": {
      "get": {
        "tags": [
          "prices"
        ],
        "summary": "Get Prices",
        "description": "Return historical daily prices for a symbol (DB-backed with provider backfill).",
        "operationId": "get_prices_prices__symbol__get",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Symbol"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "End"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriceListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/prices/{symbol}/refresh": {
      "post": {
        "tags": [
          "prices"
        ],
        "summary": "Refresh Prices",
        "description": "Force re-fetch from market data provider for the date range.",
        "operationId": "refresh_prices_prices__symbol__refresh_post",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Symbol"
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "Start"
            }
          },
          {
            "name": "end",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date",
              "title": "End"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PriceListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/analysis/dips": {
      "post": {
        "tags": [
          "analysis"
        ],
        "summary": "Analyze Dips",
        "description": "Detect historical dips and backtest a buy-the-dip strategy.",
        "operationId": "analyze_dips_analysis_dips_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DipAnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DipAnalysisResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/portfolios/": {
      "get": {
        "tags": [
          "portfolios"
        ],
        "summary": "List Portfolios Route",
        "description": "List portfolios for the authenticated user.",
        "operationId": "list_portfolios_route_portfolios__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PortfolioResponse"
                  },
                  "type": "array",
                  "title": "Response List Portfolios Route Portfolios  Get"
                }
              }
            }
          }
        }
      }
    },
    "/portfolios/{portfolio_id}": {
      "get": {
        "tags": [
          "portfolios"
        ],
        "summary": "Get Portfolio Route",
        "operationId": "get_portfolio_route_portfolios__portfolio_id__get",
        "parameters": [
          {
            "name": "portfolio_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Portfolio Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PortfolioResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/alerts/": {
      "get": {
        "tags": [
          "alerts"
        ],
        "summary": "List Alerts Route",
        "description": "List alerts for the authenticated user.",
        "operationId": "list_alerts_route_alerts__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AlertResponse"
                  },
                  "type": "array",
                  "title": "Response List Alerts Route Alerts  Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "alerts"
        ],
        "summary": "Create Alert Route",
        "operationId": "create_alert_route_alerts__post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AlertCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/reports/dips/csv": {
      "post": {
        "tags": [
          "reports"
        ],
        "summary": "Export Dips Csv",
        "description": "Run dip analysis and return results as a CSV download.",
        "operationId": "export_dips_csv_reports_dips_csv_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DipAnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/reports/dips/pdf": {
      "post": {
        "tags": [
          "reports"
        ],
        "summary": "Export Dips Pdf",
        "description": "Placeholder for PDF export.",
        "operationId": "export_dips_pdf_reports_dips_pdf_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DipAnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Export Dips Pdf Reports Dips Pdf Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AlertCreate": {
        "properties": {
          "asset_id": {
            "type": "integer",
            "title": "Asset Id"
          },
          "alert_type": {
            "type": "string",
            "title": "Alert Type",
            "default": "dip_threshold"
          },
          "threshold": {
            "type": "number",
            "title": "Threshold"
          },
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "asset_id",
          "threshold"
        ],
        "title": "AlertCreate"
      },
      "AlertResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "asset_id": {
            "type": "integer",
            "title": "Asset Id"
          },
          "alert_type": {
            "type": "string",
            "title": "Alert Type"
          },
          "threshold": {
            "type": "number",
            "title": "Threshold"
          },
          "is_active": {
            "type": "boolean",
            "title": "Is Active"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "asset_id",
          "alert_type",
          "threshold",
          "is_active",
          "created_at"
        ],
        "title": "AlertResponse"
      },
      "AssetResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "asset_type": {
            "type": "string",
            "title": "Asset Type"
          },
          "exchange": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Exchange"
          }
        },
        "type": "object",
        "required": [
          "id",
          "symbol",
          "name",
          "asset_type",
          "exchange"
        ],
        "title": "AssetResponse"
      },
      "DipAnalysisRequest": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol",
            "examples": [
              "VOO"
            ]
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "title": "Start Date"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "title": "End Date"
          },
          "dip_threshold": {
            "type": "number",
            "maximum": 0.5,
            "minimum": 0.01,
            "title": "Dip Threshold",
            "default": 0.05
          },
          "investment_amount": {
            "type": "number",
            "exclusiveMinimum": 0.0,
            "title": "Investment Amount",
            "default": 200
          },
          "lookback_days": {
            "type": "integer",
            "maximum": 365.0,
            "minimum": 5.0,
            "title": "Lookback Days",
            "default": 90
          },
          "holding_period_days": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Holding Period Days",
            "default": [
              30,
              90,
              365,
              730
            ]
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "start_date",
          "end_date"
        ],
        "title": "DipAnalysisRequest"
      },
      "DipAnalysisResponse": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "start_date": {
            "type": "string",
            "format": "date",
            "title": "Start Date"
          },
          "end_date": {
            "type": "string",
            "format": "date",
            "title": "End Date"
          },
          "dip_threshold": {
            "type": "number",
            "title": "Dip Threshold"
          },
          "total_dips_detected": {
            "type": "integer",
            "title": "Total Dips Detected"
          },
          "total_invested": {
            "type": "number",
            "title": "Total Invested"
          },
          "strategy_value": {
            "type": "number",
            "title": "Strategy Value"
          },
          "strategy_return_pct": {
            "type": "number",
            "title": "Strategy Return Pct"
          },
          "dca_return_pct": {
            "type": "number",
            "title": "Dca Return Pct"
          },
          "holding_period_summaries": {
            "items": {
              "$ref": "#/components/schemas/HoldingPeriodSummary"
            },
            "type": "array",
            "title": "Holding Period Summaries"
          },
          "dip_events": {
            "items": {
              "$ref": "#/components/schemas/DipEvent"
            },
            "type": "array",
            "title": "Dip Events"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "start_date",
          "end_date",
          "dip_threshold",
          "total_dips_detected",
          "total_invested",
          "strategy_value",
          "strategy_return_pct",
          "dca_return_pct",
          "holding_period_summaries",
          "dip_events"
        ],
        "title": "DipAnalysisResponse"
      },
      "DipEvent": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "price": {
            "type": "number",
            "title": "Price"
          },
          "rolling_high": {
            "type": "number",
            "title": "Rolling High"
          },
          "drawdown_pct": {
            "type": "number",
            "title": "Drawdown Pct"
          },
          "returns": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Returns"
          }
        },
        "type": "object",
        "required": [
          "date",
          "price",
          "rolling_high",
          "drawdown_pct",
          "returns"
        ],
        "title": "DipEvent"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HoldingPeriodSummary": {
        "properties": {
          "period_days": {
            "type": "integer",
            "title": "Period Days"
          },
          "avg_return_pct": {
            "type": "number",
            "title": "Avg Return Pct"
          },
          "median_return_pct": {
            "type": "number",
            "title": "Median Return Pct"
          },
          "win_rate_pct": {
            "type": "number",
            "title": "Win Rate Pct"
          },
          "best_return_pct": {
            "type": "number",
            "title": "Best Return Pct"
          },
          "worst_return_pct": {
            "type": "number",
            "title": "Worst Return Pct"
          }
        },
        "type": "object",
        "required": [
          "period_days",
          "avg_return_pct",
          "median_return_pct",
          "win_rate_pct",
          "best_return_pct",
          "worst_return_pct"
        ],
        "title": "HoldingPeriodSummary"
      },
      "PortfolioResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "created_at"
        ],
        "title": "PortfolioResponse"
      },
      "PriceBar": {
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "open": {
            "type": "number",
            "title": "Open"
          },
          "high": {
            "type": "number",
            "title": "High"
          },
          "low": {
            "type": "number",
            "title": "Low"
          },
          "close": {
            "type": "number",
            "title": "Close"
          },
          "adj_close": {
            "type": "number",
            "title": "Adj Close"
          },
          "volume": {
            "type": "integer",
            "title": "Volume"
          }
        },
        "type": "object",
        "required": [
          "date",
          "open",
          "high",
          "low",
          "close",
          "adj_close",
          "volume"
        ],
        "title": "PriceBar"
      },
      "PriceListResponse": {
        "properties": {
          "symbol": {
            "type": "string",
            "title": "Symbol"
          },
          "start": {
            "type": "string",
            "format": "date",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date",
            "title": "End"
          },
          "prices": {
            "items": {
              "$ref": "#/components/schemas/PriceBar"
            },
            "type": "array",
            "title": "Prices"
          }
        },
        "type": "object",
        "required": [
          "symbol",
          "start",
          "end",
          "prices"
        ],
        "title": "PriceListResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}