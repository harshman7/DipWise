# PostgreSQL
POSTGRES_USER=dipwise
POSTGRES_PASSWORD=dipwise_secret
POSTGRES_DB=dipwise

# Database
DATABASE_URL=postgresql://dipwise:dipwise_secret@postgres:5432/dipwise

# Redis
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET_KEY=change-me-to-a-random-secret

# Market data: yahoo (default, no key), polygon, or alphavantage
MARKET_DATA_PROVIDER=yahoo
# Required for polygon or alphavantage
MARKET_DATA_API_KEY=

# News (optional)
NEWS_API_KEY=

# Frontend
VITE_API_BASE_URL=http://localhost:8000
